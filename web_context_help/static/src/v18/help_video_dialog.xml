<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_context_help.HelpVideoDialog">
        <Dialog title.translate="Insert a help video" size="'md'">
            <p class="text-muted small mb-2">
                <i class="fa fa-folder-open-o me-1"/><t t-esc="state.path"/>
            </p>
            <div t-if="!state.exists" class="alert alert-warning">
                The video directory does not exist: set the system parameter web_help_video_path.
            </div>
            <t t-else="">
                <input type="search" class="form-control mb-2" t-model="state.filter"
                       placeholder="Search a video"/>
                <div t-if="!videos.length" class="text-muted">No video found.</div>
                <div class="list-group o_wch_video_list">
                    <button t-foreach="videos" t-as="video" t-key="video.name" type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between"
                            t-on-click="() => this.select(video)">
                        <span><i class="fa fa-film me-2"/><t t-esc="video.name"/></span>
                        <span class="text-muted small"><t t-esc="formatSize(video.size)"/></span>
                    </button>
                </div>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
