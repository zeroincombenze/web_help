<templates xml:space="preserve">
    <t t-name="web_context_help.Button">
        <button t-if="!env.inDialog" type="button" class="btn btn-link o_wch_button"
            title="Help" aria-label="Help" data-hotkey="shift+h"
            t-on-click="onContextHelpClick">
            <i class="fa fa-life-ring text-danger"/>
        </button>
    </t>
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="inside">
            <t t-call="web_context_help.Button"/>
        </xpath>
    </t>
</templates>
