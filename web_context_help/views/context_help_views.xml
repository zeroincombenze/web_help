<odoo>

    <record id="context_help_page_tree" model="ir.ui.view">
        <field name="name">context.help.page.list</field>
        <field name="model">context.help.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="key"/>
                <field name="lang"/>
                <field name="name"/>
                <field name="module"/>
                <field name="model"/>
                <field name="view_type"/>
                <field name="priority"/>
                <field name="clear_cut"/>
                <field name="edited"/>
                <field name="source_changed"/>
            </list>
        </field>
    </record>

    <record id="context_help_page_form" model="ir.ui.view">
        <field name="name">context.help.page.form</field>
        <field name="model">context.help.page</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" class="oe_highlight"/>
                    <button name="action_reset_to_source" type="object" string="Reset to source"
                        invisible="not edited or not source_file"
                        confirm="Discard the changes made to this page?"/>
                    <button name="action_source_seen" type="object" string="Keep my version"
                        invisible="not source_changed"/>
                    <button name="action_rebuild" type="object" string="Rebuild all pages"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                        invisible="not source_changed">
                        The source of this page changed after it was edited:
                        reset to source or keep your version.
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="name"/>
                            <field name="lang"/>
                            <field name="module"/>
                            <field name="source_file"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="view_xmlid"/>
                            <field name="view_type"/>
                            <field name="when" readonly="1" invisible="not when"/>
                            <!-- the rebuild sets the pages of the modules back to 96 -->
                            <field name="priority" readonly="source_file"/>
                            <field name="clear_cut"/>
                            <field name="edited"/>
                            <field name="source_changed"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="content" string="Content">
                            <field name="html" widget="wch_html" options="{'codeview': true}" class="o_wch_html"/>
                        </page>
                        <page name="source" string="Source">
                            <field name="source_html" widget="html" options="{'codeview': true}" class="o_wch_html"/>
                        </page>
                        <page name="rules" string="Rules" invisible="not model or not clear_cut">
                            <p class="text-muted">
                                This clear cut page is shown only when the open record
                                meets one of these rules. Clear cut pages are checked
                                first, in priority order (1 is the highest); with no
                                rule met, the general page with the highest priority
                                is shown, the pages of the modules being the last.
                            </p>
                            <field name="rule_ids" context="{'default_page_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model" column_invisible="1"/>
                                    <field name="field_type" column_invisible="1"/>
                                    <field name="relation" column_invisible="1"/>
                                    <field name="field_id" options="{'no_create': True}"/>
                                    <field name="operator"/>
                                    <field name="selection_ids" widget="many2many_tags"
                                        options="{'no_create': True}"
                                        invisible="field_type != 'selection'"/>
                                    <field name="value_boolean"
                                        invisible="field_type != 'boolean'"/>
                                    <field name="relation_model_id" column_invisible="1"/>
                                    <field name="record_ref"
                                        options="{'model_field': 'relation_model_id', 'no_create': True, 'no_open': True}"
                                        invisible="field_type != 'many2one'"/>
                                    <field name="condition"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page name="sections" string="Sections">
                            <field name="section_ids">
                                <list>
                                    <field name="label"/>
                                    <field name="title"/>
                                    <field name="question"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="context_help_page_search" model="ir.ui.view">
        <field name="name">context.help.page.search</field>
        <field name="model">context.help.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="key"/>
                <field name="name"/>
                <field name="model"/>
                <field name="module"/>
                <filter name="edited" string="Edited" domain="[('edited', '=', True)]"/>
                <filter name="source_changed" string="Source changed"
                    domain="[('source_changed', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_module" string="Module" context="{'group_by': 'module'}"/>
                    <filter name="group_lang" string="Language" context="{'group_by': 'lang'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="context_help_question_tree" model="ir.ui.view">
        <field name="name">context.help.question.list</field>
        <field name="model">context.help.question</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="question"/>
                <field name="model"/>
                <field name="page_key"/>
                <field name="found"/>
                <field name="answer_page_id"/>
                <field name="provider"/>
            </list>
        </field>
    </record>

    <record id="context_help_question_search" model="ir.ui.view">
        <field name="name">context.help.question.search</field>
        <field name="model">context.help.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="model"/>
                <field name="user_id"/>
                <filter name="not_found" string="Unanswered" domain="[('found', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="context_help_rule_tree" model="ir.ui.view">
        <field name="name">context.help.rule.list</field>
        <field name="model">context.help.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="page_id"/>
                <field name="model"/>
                <field name="condition"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="context_help_rule_form" model="ir.ui.view">
        <field name="name">context.help.rule.form</field>
        <field name="model">context.help.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!-- field, operator and value read as one condition -->
                        <group>
                            <field name="page_id" options="{'no_create': True}"/>
                            <field name="field_id" options="{'no_create': True}"
                                readonly="not model"/>
                            <field name="field_type" invisible="1"/>
                            <field name="relation" invisible="1"/>
                            <field name="operator"/>
                            <field name="selection_ids" widget="many2many_tags"
                                options="{'no_create': True}"
                                invisible="field_type != 'selection'"/>
                            <field name="value_boolean"
                                invisible="field_type != 'boolean'"/>
                            <field name="relation_model_id" invisible="1"/>
                            <field name="record_ref"
                                options="{'model_field': 'relation_model_id', 'no_create': True, 'no_open': True}"
                                invisible="field_type != 'many2one'"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="condition"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="context_help_rule_search" model="ir.ui.view">
        <field name="name">context.help.rule.search</field>
        <field name="model">context.help.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="page_id"/>
                <field name="model"/>
                <field name="field_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_context_help_page" model="ir.actions.act_window">
        <field name="name">Help Pages</field>
        <field name="res_model">context.help.page</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_context_help_rule" model="ir.actions.act_window">
        <field name="name">Help Rules</field>
        <field name="res_model">context.help.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_context_help_question" model="ir.actions.act_window">
        <field name="name">Help Questions</field>
        <field name="res_model">context.help.question</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_context_help_home" model="ir.actions.client">
        <field name="name">Help</field>
        <field name="tag">web_context_help.home</field>
    </record>

    <!-- Top menu: opens the help home page, with the summary of all the pages -->
    <menuitem id="menu_help_root" name="Help" action="action_context_help_home"
        web_icon="web_context_help,static/description/icon.png"
        groups="base.group_user" sequence="990"/>
    <!-- Menus of the help editors, in the Help app, the Technical menu being
         for the administrators in debug mode. The Help app opens the help
         window; for the editors it also shows these menus in the top bar -->
    <menuitem id="menu_help_editor_root" name="Help Editor" parent="menu_help_root"
        groups="group_help_editor" sequence="10"/>
    <menuitem id="menu_help_editor_page" name="Help Pages" action="action_context_help_page"
        parent="menu_help_editor_root" sequence="10"/>
    <menuitem id="menu_help_editor_rule" name="Help Rules" action="action_context_help_rule"
        parent="menu_help_editor_root" sequence="15"/>
    <menuitem id="menu_help_editor_question" name="Help Questions" action="action_context_help_question"
        parent="menu_help_editor_root" sequence="20"/>

    <menuitem id="menu_context_help" name="Context Help"
        parent="base.menu_custom" sequence="90"/>
    <menuitem id="menu_context_help_page" action="action_context_help_page"
        parent="menu_context_help" sequence="10"/>
    <menuitem id="menu_context_help_rule" action="action_context_help_rule"
        parent="menu_context_help" sequence="15"/>
    <menuitem id="menu_context_help_question" action="action_context_help_question"
        parent="menu_context_help" sequence="20"/>

</odoo>
